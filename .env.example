# Discord Bot Token
# Discord Developer Portal에서 발급: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application ID
CLIENT_ID=your_application_id_here

# Discord Server ID (테스트용 서버 전용 명령어 등록, 비워두면 생략)
GUILD_ID=your_server_id_here

# 접근 제어 (쉼표 구분, 비워두면 모두 허용)
# 봇을 사용할 수 있는 서버 ID 목록 (DM은 사용자 목록만 확인)
ALLOWED_GUILD_IDS=
# 봇을 사용할 수 있는 Discord 사용자 ID 목록
ALLOWED_USER_IDS=

# Redmine 설정 (주간보고 기능용)
REDMINE_BASE_URL=https://your-redmine-url.com
# 보고서를 조회할 수 있는 권한의 API 키
REDMINE_API_KEY=your_redmine_api_key_here
# Discord 사용자 ID <-> Redmine 사용자 ID 매핑 (본인 기록만 조회 가능)
# 형식: discordId:redmineId,discordId:redmineId
REDMINE_USER_MAP=
